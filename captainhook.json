{
    "$schema": "https://captainhookphp.github.io/captainhook/schema.json",
    "commit-msg": {
        "enabled": true,
        "actions": [
            {
                "action": "\\CaptainHook\\App\\Hook\\Message\\Action\\Regex",
                "options": {
                    "regex": "/^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\\(.+\\))?!?:\\s[A-Z].{0,99}$/",
                    "error": "Commit message must follow Conventional Commits with an uppercase subject: <type>(<scope>): Subject"
                }
            }
        ]
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "\\CaptainHook\\App\\Hook\\PHP\\Action\\Linting",
                "options": {
                    "extensions": "php"
                }
            },
            {
                "action": "bash -lc 'command -v gitleaks >/dev/null || { echo \"Install gitleaks: brew install gitleaks\"; exit 1; }; gitleaks protect --staged --verbose --redact --config=.gitleaks.toml'",
                "conditions": []
            },
            {
                "action": "composer lint:pint",
                "conditions": []
            },
            {
                "action": "composer lint:phpcs",
                "conditions": []
            },
            {
                "action": "composer lint:phpstan",
                "conditions": []
            },
            {
                "action": "composer lint:phpmd",
                "conditions": []
            },
            {
                "action": "composer lint:cs",
                "conditions": []
            }
        ]
    },
    "pre-push": {
        "enabled": true,
        "actions": [
            {
                "action": "bash -lc 'command -v gitleaks >/dev/null && gitleaks detect --verbose --redact --config=.gitleaks.toml || true'",
                "conditions": []
            },
            {
                "action": "composer test",
                "conditions": []
            }
        ]
    },
    "post-merge": {
        "enabled": false,
        "actions": []
    },
    "post-checkout": {
        "enabled": false,
        "actions": []
    },
    "post-rewrite": {
        "enabled": false,
        "actions": []
    },
    "post-change": {
        "enabled": false,
        "actions": []
    },
    "prepare-commit-msg": {
        "enabled": false,
        "actions": []
    }
}
